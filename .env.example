# Skopírujte do .env.local a doplňte. .env.local sa necommituje.

# Verejná adresa webu (pre metadata a náhľady pri zdieľaní). Doména ešte nie je.
# Na Verceli ju netreba, kým nie je doména: použije sa adresa projektu *.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kontaktný formulár: kam chodia správy a kľúč služby, ktorá ich odošle (napr. Resend).
CONTACT_TO_EMAIL=
RESEND_API_KEY=
