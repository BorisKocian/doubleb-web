# Skopírujte do .env.local a doplňte. .env.local sa necommituje.

# Verejná adresa webu (pre metadata a náhľady pri zdieľaní). Doména ešte nie je.
# Na Verceli ju netreba, kým nie je doména: použije sa adresa projektu *.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kontaktný formulár cez Resend (resend.com). Kľúč stačí s právom len na odosielanie.
# CONTACT_TO_EMAIL: kam chodia správy (predvolene e-mail zo src/config/site.ts).
# CONTACT_FROM_EMAIL: odosielateľ na overenej doméne (predvolene "DoubleB web <web@doubleb.dev>").
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
